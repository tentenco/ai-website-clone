{
  "name": "ai-website-clone-engine",
  "version": "0.1.1",
  "private": true,
  "description": "Evidence-driven AI workflow for website reconstruction, motion analysis, and deterministic fidelity QA",
  "author": "AI Website Clone Engine contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tentenco/ai-website-clone.git"
  },
  "homepage": "https://github.com/tentenco/ai-website-clone#readme",
  "bugs": {
    "url": "https://github.com/tentenco/ai-website-clone/issues"
  },
  "keywords": [
    "ai-agents",
    "website-reconstruction",
    "reverse-engineering",
    "motion-analysis",
    "visual-regression-testing",
    "nextjs",
    "typescript",
    "tailwindcss",
    "shadcn-ui"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "preflight": "node scripts/clone-preflight.mjs",
    "init:clone": "node scripts/init-clone-target.mjs",
    "sync:skills": "node scripts/sync-skills.mjs",
    "check:skills": "node scripts/sync-skills.mjs --check",
    "test:skills": "node scripts/run-skill-tests.mjs",
    "check": "npm run check:skills && npm run test:skills && npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.16.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
